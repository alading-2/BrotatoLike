<Project Sdk="Godot.NET.Sdk/4.6.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyName>BrotatoLike</AssemblyName>
    <RootNamespace>BrotatoLike</RootNamespace>
    <SlimeAIGameOSProject Condition=" '$(SlimeAIGameOSProject)' == '' ">SlimeAI/GameOS/SlimeAI.GameOS.csproj</SlimeAIGameOSProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(SlimeAIGameOSProject)" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="MigrationInput/**/*.cs" />
    <Compile Remove="SlimeAI/**/*.cs" />
    <Compile Include="SlimeAI/Src/SceneTests/**/*.cs" />
  </ItemGroup>
</Project>
